# Copie para .env e ajuste.
PORT=3000
# Endereço público (com https:// os cookies de login ficam marcados como seguros).
# Também é a base dos links que o robô manda e das URLs de webhook do WhatsApp.
PUBLIC_URL=https://seudominio.com.br
# Domínio para o HTTPS automático (Caddy) no docker compose --profile https.
DOMAIN=seudominio.com.br
# Fuso da agenda, dos lembretes e das campanhas.
APP_TIMEZONE=America/Sao_Paulo

# Robô com inteligência artificial (Claude). Sem a chave, o robô responde por menu
# (CARTÃO, HORÁRIOS, CANCELAR) e continua entendendo SIM/NÃO nas ofertas.
ANTHROPIC_API_KEY=
# Modelo e esforço do robô (padrão: claude-opus-5-5, esforço low).
# BOT_MODEL=claude-opus-5-5
# BOT_EFFORT=low

# Mostra o código de acesso do cliente na tela quando o WhatsApp da barbearia não está
# conectado. Use só em demonstração (1); em produção deixe 0.
DEMO_LOGIN_CODES=0
# Versão da API do WhatsApp oficial (Meta).
# META_GRAPH_VERSION=v23.0
# 0 desliga lembretes, horário de costume e recontato automáticos.
# AUTOMATIONS=1
